{
  "name": "shadow-depths",
  "version": "0.2.0",
  "description": "Shadow Depths — a turn-based roguelike dark fantasy. Foundation build (v0.1).",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint src --ext .js",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "sim": "node scripts/sim.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:init": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "android:bundle": "powershell -ExecutionPolicy Bypass -File scripts/build-release-aab.ps1",
    "android:bundle:full": "powershell -ExecutionPolicy Bypass -File scripts/setup-and-build-aab.ps1",
    "playstore:prep": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.3.4",
    "@capgo/native-purchases": "^8.6.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "eslint": "^9.0.0",
    "source-map": "^0.7.6",
    "vite": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
