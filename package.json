{
  "name": "shadow-depths",
  "version": "0.1.0",
  "description": "Shadow Depths — a turn-based roguelike dark fantasy. Foundation build (v0.1).",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint src --ext .js",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "sim": "node scripts/sim.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:init": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "eslint": "^9.0.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
