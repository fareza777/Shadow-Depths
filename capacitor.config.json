{
  "appId": "com.shadowdepths.game",
  "appName": "Shadow Depths",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "buildOptions": {
      "keystorePath": "android/release.keystore",
      "keystoreAlias": "shadow-depths"
    },
    "allowMixedContent": false,
    "minWebViewVersion": 80
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#08060c",
      "showSpinner": false
    }
  }
}
